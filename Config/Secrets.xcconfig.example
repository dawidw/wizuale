// Copy this file to Config/Secrets.xcconfig and paste your key.
// Request one at https://getsongbpm.com/api — a backlink is required.
// Config/Secrets.xcconfig is gitignored. Do not commit a real key.
//
// The setting name has to stay GETSONGBPM_API_KEY. The tvOS target's
// Info.plist maps it to GetSongBPMAPIKey, which the app reads at launch.
GETSONGBPM_API_KEY = YOUR_KEY_HERE
